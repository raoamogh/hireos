# HIREOS local development configuration
# Copy this file to .env and replace placeholder values.

# Application
APP_ENV=development
APP_PORT=8080

# PostgreSQL
POSTGRES_DB=hireos
POSTGRES_USER=hireos
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_ONLY
POSTGRES_HOST=localhost
POSTGRES_PORT=5434

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# MinIO AIStor
MINIO_ROOT_USER=hireos_admin
MINIO_ROOT_PASSWORD=CHANGE_ME_LOCAL_ONLY
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=hireos-local
MINIO_USE_SSL=false

# Temporal
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
